#include "DepthKit.hlsl"

Texture2DArray<float> inputDepthTex;
RWTexture2DArray<float> agDepthTexRW;
RWTexture2DArray<float4> agDepthNormalTexRW;
RWTexture2D<half> agDepthReadback;
Texture2D<float> inputRawMonoDepth;

int eye = 0;

#pragma kernel DepthClear
[numthreads(8, 8, 1)]
void DepthClear(uint3 id : SV_DispatchThreadID)
{
	agDepthTexRW[id] = 1.0;
}

#pragma kernel DepthCopy

[numthreads(8, 8, 1)]
void DepthCopy(uint3 id : SV_DispatchThreadID)
{
	agDepthTexRW[id] = inputDepthTex[id];
}

#pragma kernel MonoRawDepthToStereo

[numthreads(8, 8, 1)]
void MonoRawDepthToStereo(uint2 id : SV_DispatchThreadID)
{
	const float z = inputRawMonoDepth[id.xy];
	const float near = agDepthZParams.x;
	const float far = agDepthZParams.y;
	float depth = (far / (far - near)) - (far * near) / ((far - near) * z);

	agDepthTexRW[uint3(id.xy, 0)] = depth;
	agDepthTexRW[uint3(id.xy, 1)] = depth;
}

#pragma kernel DepthNorm

// todo https://wickedengine.net/2019/09/improved-normal-reconstruction-from-depth/
[numthreads(8, 8, 1)]
void DepthNorm(uint3 id : SV_DispatchThreadID)
{
	float2 texSizeF = agDepthTexSize;

	uint2 ind = id.xy;
	float2 uv = id.xy / texSizeF;
	uint eye = id.z;

	const float depth = agDepthTex[uint3(ind, eye)];
	const float depthH = agDepthTex[uint3(ind + uint2(1, 0), eye)];
	const float depthV = agDepthTex[uint3(ind + uint2(0, 1), eye)];

	// no normal across unknown depth: a zero normal fails every facing test
	if (!agDepthIsKnown(depth) || !agDepthIsKnown(depthH) || !agDepthIsKnown(depthV))
	{
		agDepthNormalTexRW[id] = 0;
		return;
	}

	float3 depthWorld = agDepthNDCtoWorld(float3(uv, depth), eye);

	ind = id.xy + uint2(1, 0);
	uv = ind / texSizeF;
	float3 depthWorldH = agDepthNDCtoWorld(float3(uv, depthH), eye);

	ind = id.xy + uint2(0, 1);
	uv = ind / texSizeF;
	float3 depthWorldV = agDepthNDCtoWorld(float3(uv, depthV), eye);

	const float3 hDeriv = depthWorldH - depthWorld;
	const float3 vDeriv = depthWorldV - depthWorld;

	float3 worldNorm = -normalize(cross(hDeriv, vDeriv));

	agDepthNormalTexRW[id] = float4(worldNorm, 1.0);
}

#pragma kernel ConvertDepth

[numthreads(8, 8, 1)]
void ConvertDepth(uint2 id : SV_DispatchThreadID)
{
	agDepthReadback[id] = agDepthTex[uint3(id, 0)];
}

