<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/Menu/FlashingLabel.uss?fileID=7433441132597879392&amp;guid=44eea67dbe71743bb8f435927b744ae8&amp;type=3#FlashingLabel"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Main%20Menu/Connection/ConnectionHomePage.uss?fileID=7433441132597879392&amp;guid=cce6fdc4810a4c4abc90c390453de53e&amp;type=3#ConnectionHomePage"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="ConnectionMenu" entry="ConnectionHomePage.navheader-2.title"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <Anaglyph.Menu.FlashingLabel name="session-discovery-status" class="body-copy session-discovery-status" style="-unity-text-align: middle-center;"/>
        <Anaglyph.Menu.NavButton name="manual-connect-button" target="manual-connect-page">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionHomePage.manual-connect-button.text"/>
            </Bindings>
        </Anaglyph.Menu.NavButton>
        <ui:VisualElement class="host-mode-cards">
            <ui:Button name="host-mode-direct" class="host-mode-card">
                <ui:Label picking-mode="Ignore" class="host-mode-card__name"/>
                <ui:Label picking-mode="Ignore" class="host-mode-card__status"/>
            </ui:Button>
            <ui:Button name="host-mode-lan" class="host-mode-card">
                <ui:Label picking-mode="Ignore" class="host-mode-card__name"/>
                <ui:Label picking-mode="Ignore" class="host-mode-card__status"/>
            </ui:Button>
            <ui:Button name="host-mode-relay" class="host-mode-card">
                <ui:Label picking-mode="Ignore" class="host-mode-card__name"/>
                <ui:Label picking-mode="Ignore" class="host-mode-card__status"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:Label name="host-mode-about" class="host-mode-about"/>
        <ui:Button name="host-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionHomePage.host-button.text"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
