<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle" />
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="ConnectionMenu" entry="ConnectionManualConnectPage.navheader-2.title" />
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:Toggle name="use-relay-toggle">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionManualConnectPage.use-relay-toggle.text" />
            </Bindings>
        </ui:Toggle>
        <ui:VisualElement name="ip-field-row" class="field-row">
            <ui:Label>
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionManualConnectPage.label-5.text" />
                </Bindings>
            </ui:Label>
            <ui:TextField name="ip-field" keyboard-type="URL" />
        </ui:VisualElement>
        <ui:VisualElement name="room-field-row" class="field-row">
            <ui:Label>
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionManualConnectPage.label-8.text" />
                </Bindings>
            </ui:Label>
            <ui:TextField name="room-field" keyboard-type="ASCIICapable" />
            <ui:Label class="body-copy">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionManualConnectPage.label-10.text" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:Button name="connect-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionManualConnectPage.connect-button.text" />
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
