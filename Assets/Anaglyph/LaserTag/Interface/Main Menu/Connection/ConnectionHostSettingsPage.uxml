<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Style src="ConnectionHostSettingsPage.uss"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="ConnectionMenu" entry="ConnectionHostSettingsPage.navheader-2.title"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:VisualElement name="host-mode-diagram" class="host-mode-diagram">
            <ui:Button name="host-mode-relay" class="host-mode-tile">
                <ui:VisualElement picking-mode="Ignore" class="host-mode-tile__icon host-mode-tile__icon--relay"/>
                <ui:VisualElement picking-mode="Ignore" class="host-mode-tile__text">
                    <ui:Label picking-mode="Ignore" class="host-mode-tile__name"/>
                    <ui:Label picking-mode="Ignore" class="host-mode-tile__status"/>
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="host-mode-lan" class="host-mode-tile">
                <ui:VisualElement picking-mode="Ignore" class="host-mode-tile__icon host-mode-tile__icon--lan"/>
                <ui:VisualElement picking-mode="Ignore" class="host-mode-tile__text">
                    <ui:Label picking-mode="Ignore" class="host-mode-tile__name"/>
                    <ui:Label picking-mode="Ignore" class="host-mode-tile__status"/>
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="host-mode-direct" class="host-mode-tile">
                <ui:VisualElement picking-mode="Ignore" class="host-mode-tile__icon host-mode-tile__icon--direct"/>
                <ui:VisualElement picking-mode="Ignore" class="host-mode-tile__text">
                    <ui:Label picking-mode="Ignore" class="host-mode-tile__name"/>
                    <ui:Label picking-mode="Ignore" class="host-mode-tile__status"/>
                </ui:VisualElement>
            </ui:Button>
            <ui:VisualElement name="host-mode-headset-left" picking-mode="Ignore" class="host-mode-headset host-mode-headset--left"/>
            <ui:VisualElement name="host-mode-headset-right" picking-mode="Ignore" class="host-mode-headset host-mode-headset--right"/>
        </ui:VisualElement>
        <ui:Label name="host-mode-about" class="host-mode-about"/>
        <ui:Button name="host-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionHostSettingsPage.host-button.text"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
