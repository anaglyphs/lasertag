.host-mode-cards {
    flex-direction: row;
}

.host-mode-card {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 58px;
    justify-content: center;
}

.host-mode-card > Label {
    margin: 0;
    -unity-text-align: middle-center;
}

.host-mode-card__name {
    -unity-font-definition: var(--font-bold);
}

.unity-label.host-mode-card__status {
    font-size: var(--font-size-small, 14px);
}

.unity-button.host-mode-card--unusable {
    --text-color: var(--primary);
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary);
}

.unity-button.host-mode-card--unusable:hover {
    border-color: var(--highlight);
}

.host-mode-card--unusable > .host-mode-card__status {
    color: rgb(255, 210, 80);
}

.host-mode-about {
    flex-grow: 1;
    white-space: normal;
    font-size: var(--font-size-small, 14px);
    min-height: 40px;
}
