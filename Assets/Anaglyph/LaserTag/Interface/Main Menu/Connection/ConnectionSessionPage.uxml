<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="ConnectionMenu" entry="ConnectionSessionPage.navheader-2.title"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:Label name="session-state" class="title"/>
        <ui:Label name="session-address" class="body-copy"/>
        <ui:VisualElement style="flex-grow: 1;"/>
        <ui:Button name="disconnect-button" class="destructive">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionSessionPage.disconnect-button.text"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
