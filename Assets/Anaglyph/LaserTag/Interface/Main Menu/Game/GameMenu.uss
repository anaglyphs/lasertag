.game-menu {
    width: 400px;
    height: 400px;
    flex-shrink: 0;
    font-size: 20px;
}

/* A fixed-size box in the headset; on a screen it takes the room there is */
.touch-screen .game-menu {
    width: auto;
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
}

.game-menu-tabs {
    flex-direction: row;
    height: 46px;
    flex-shrink: 0;
}

/* Over each menu's home page, in the header's place, flush with the panel's edges.
   The negative margins take back the outer tabs' half gaps. */
.game-menu-tabs--in-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    margin-left: -2px;
    margin-right: -2px;
}

/* Home pages keep their header's space for the tabs */
.nav-page--under-tabs .nav-header {
    visibility: hidden;
}

.game-menu-tab {
    --text-color: var(--secondary);
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    margin-left: 2px;
    margin-right: 2px;
    border-width: 0;
    border-color: var(--primary);
    border-radius: 0;
    background-color: var(--primary);
    color: var(--secondary);
    -unity-text-align: middle-center;
}

.game-menu-tab-selected,
.game-menu-tab:hover:enabled {
    background-color: var(--highlight);
    border-color: var(--highlight);
}

.game-menu-hidden {
    display: none;
}

.demo-instructions {
    white-space: normal;
}

.demo-weapons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-medium);
}

.demo-weapons > Button {
    flex-basis: 40%;
    flex-grow: 1;
}
