.game-menu {
    width: 400px;
    height: 400px;
    flex-shrink: 0;
    font-size: 20px;
}

/* A fixed-size box in the headset; on a screen it takes the room there is */
.touch-screen .game-menu {
    width: auto;
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
}

.game-menu-tabs {
    flex-direction: row;
    height: 46px;
    flex-shrink: 0;
}

.game-menu-tab {
    --text-color: var(--secondary);
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    margin-left: 2px;
    margin-right: 2px;
    border-width: 0;
    border-color: var(--primary);
    border-radius: 0;
    background-color: var(--primary);
    color: var(--secondary);
    -unity-text-align: middle-center;
}

.game-menu-tab-selected,
.game-menu-tab:hover:enabled {
    background-color: var(--highlight);
    border-color: var(--highlight);
}

.game-menu-hidden {
    display: none;
}
