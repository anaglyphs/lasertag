        </ui:Label>
        <ui:Button name="place-bases-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="bases.edit-map"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
