        <Anaglyph.LaserTag.Interface.HUD.ScoreDisplay />
        <ui:Button name="stop-button" class="destructive">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="GameMatchPlayingPage.stop-button.text" />
