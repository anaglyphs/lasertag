<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Shared/Game/MapFields.uss?fileID=7433441132597879392&amp;guid=f4c687285f094fca87062d2e41ca92d4&amp;type=3#MapFields"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Shared/Game/MapCatalog.uss?fileID=7433441132597879392&amp;guid=c344be5d12214a3d90a789a1e8607525&amp;type=3#MapCatalog"/>
    <Style src="project://database/Assets/Anaglyph/Menu/FlashingLabel.uss?fileID=7433441132597879392&amp;guid=44eea67dbe71743bb8f435927b744ae8&amp;type=3#FlashingLabel"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="Map" entry="maps.title"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:VisualElement name="loaded-space-maps-section" class="map-catalog-section">
            <ui:ScrollView name="map-list"/>
            <Anaglyph.Menu.FlashingLabel name="recognizing-space-label" class="body-copy recognizing-space-label">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="Map" entry="maps.recognizing"/>
                </Bindings>
            </Anaglyph.Menu.FlashingLabel>
            <ui:VisualElement class="map-actions layout-actions">
                <ui:Button name="manage-maps-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Map" entry="maps.manage"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
