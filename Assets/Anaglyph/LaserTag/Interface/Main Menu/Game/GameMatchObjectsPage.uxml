<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Shared/Game/MapFields.uss?fileID=7433441132597879392&amp;guid=f4c687285f094fca87062d2e41ca92d4&amp;type=3#MapFields"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Shared/Game/MapCatalog.uss?fileID=7433441132597879392&amp;guid=c344be5d12214a3d90a789a1e8607525&amp;type=3#MapCatalog"/>
    <Style src="project://database/Assets/Anaglyph/Menu/FlashingLabel.uss?fileID=7433441132597879392&amp;guid=44eea67dbe71743bb8f435927b744ae8&amp;type=3#FlashingLabel"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="GameMenu" entry="match-objects.title"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <Anaglyph.Menu.FlashingLabel name="recognizing-space-label" class="body-copy recognizing-space-label">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="Map" entry="maps.recognizing"/>
            </Bindings>
        </Anaglyph.Menu.FlashingLabel>
        <ui:VisualElement name="match-objects-section" class="map-settings-spacer">
            <ui:Label name="match-objects-instructions" class="body-copy">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="match-objects.instructions"/>
                </Bindings>
            </ui:Label>
            <ui:Label name="missing-bases-warning" class="body-copy warning">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="match-objects.bases-required"/>
                </Bindings>
            </ui:Label>
            <ui:Label name="missing-flags-warning" class="body-copy warning">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="match-objects.flag-required"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:Button name="place-objects-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="match-objects.place"/>
            </Bindings>
        </ui:Button>
        <ui:Button name="start-match-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="GameMatchSettingsPage.start-button.text"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
