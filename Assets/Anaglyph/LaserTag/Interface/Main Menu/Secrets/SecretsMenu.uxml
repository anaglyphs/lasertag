<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Main%20Menu/Secrets/SecretsMenu.uss?fileID=7433441132597879392&amp;guid=eb78793a9a25944db986b5de76f5d6b3&amp;type=3#SecretsMenu"/>
    <ui:VisualElement picking-mode="Ignore" class="menu-root neutral-panel">
        <Anaglyph.Menu.NavView first-page="secrets-page">
            <Anaglyph.Menu.NavPage name="secrets-page" show-back-button="false">
                <ui:VisualElement class="page-template-root">
                    <Anaglyph.Menu.NavHeader>
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="Title" table="SecretsMenu" entry="SecretsMenu.navheader.title"/>
                        </Bindings>
                    </Anaglyph.Menu.NavHeader>
                    <ui:Toggle name="host-prototype-zombies-toggle">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="SecretsMenu" entry="SecretsMenu.host-prototype-zombies-toggle.text"/>
                        </Bindings>
                    </ui:Toggle>
                </ui:VisualElement>
            </Anaglyph.Menu.NavPage>
        </Anaglyph.Menu.NavView>
    </ui:VisualElement>
</ui:UXML>
