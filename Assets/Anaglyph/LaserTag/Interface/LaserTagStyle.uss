* {
    -unity-font-definition: var(--font-regular);
    color: var(--text-color, rgb(255, 255, 255));
    --spacing-small: 4px;
    --spacing-medium: 8px;
    --spacing-large: 12px;
    --control-icon-spacing: 10px;
    --font-size-body: 20px;
    --font-size-title: 32px;
    --font-size-small: 14px;
    --control-min-height: 46px;
    --control-border-width: 1px;
    --panel-border-width: 2px;
    --scrollbar-size: 24px;
    --scrollbar-button-clearance: 28px;
    --panel-frame-padding: 12px;
    /* The frame line's inner edge, and how far that sits outside the panel padding */
    --panel-frame-inset: 8px;
    --panel-frame-gap: 4px;
    --panel-frame-gap-negative: -4px;
    --header-button-size: 38px;
    --highlight: rgb(255, 255, 255);
    --disabled: rgb(128, 128, 128);
}

.bold {
    -unity-font-definition: var(--font-bold);
}

.italic {
    -unity-font-definition: var(--font-italic);
}

.bold.italic {
    -unity-font-definition: var(--font-bold-italic);
}

/* Panel colors: neutral unless a panel class follows */
.menu-root,
.neutral-panel {
    --primary: rgb(200, 200, 200);
    --secondary: rgb(20, 20, 20);
}

.menu-root {
    flex-grow: 1;
    background-color: var(--secondary);
    color: rgb(255, 255, 255);
    font-size: var(--font-size-body, 20px);
    padding: var(--panel-frame-padding, 12px);
    background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/panel-frame.svg");
    -unity-background-image-tint-color: var(--primary);
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
}

.multiplayer-panel {
    --primary: rgb(255, 38, 57);
    --secondary: rgb(20, 0, 25);
}

.multiplayer-panel.session-connected {
    --primary: rgb(236, 255, 61);
    --secondary: rgb(22, 25, 0);
}

.game-panel {
    --primary: rgb(0, 230, 230);
    --secondary: rgb(11, 0, 25);
}

.settings-panel {
    --primary: rgb(255, 138, 89);
    --secondary: rgb(16, 0, 4);
}

.unity-toggle__checkmark,
.nav-header__back-button {
    margin-right: var(--control-icon-spacing, 10px);
}

.unity-base-text-field > .unity-base-text-field__input {
    --text-color: white;
    height: var(--control-min-height, 46px);
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
    color: white;
}

.unity-base-text-field:hover:enabled > .unity-base-text-field__input,
.unity-base-text-field:focus:enabled > .unity-base-text-field__input,
.unity-base-text-field > .unity-base-text-field__input:focus {
    border-color: var(--highlight);
}

.unity-toggle,
.unity-radio-button {
    --text-color: white;
    --selection-outline: var(--primary, rgb(150, 150, 150));
}

.unity-toggle:hover:enabled,
.unity-toggle:focus:enabled,
.unity-radio-button:hover:enabled,
.unity-radio-button:focus:enabled {
    --selection-outline: var(--highlight);
}

.unity-toggle__input:checked,
.unity-radio-button__input:checked {
    --selection-outline: white;
}

.unity-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--selection-outline);
}

.unity-base-slider #unity-tracker {
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
}

.unity-base-slider #unity-dragger {
    background-color: var(--primary, rgb(150, 150, 150));
    border-width: 0;
}

.unity-base-slider #unity-fill {
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-base-slider:hover:enabled #unity-dragger,
.unity-base-slider:focus:enabled #unity-dragger {
    background-color: var(--highlight);
}

RadioButton .unity-radio-button__checkmark-background {
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--selection-outline);
    padding: 0;
}

RadioButton #unity-checkmark {
    width: 100%;
    height: 100%;
    background-color: white;
    border-radius: 100%;
}

.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: none;
    background-color: white;
}

.menu-root .nav-view {
    --nav-transition-duration-ms: 100;
}

.nav-view,
.nav-page,
.nav-page > TemplateContainer {
    flex-grow: 1;
}

.nav-page {
    justify-content: flex-start;
}

.nav-page--modal-transition {
    background-color: var(--secondary, rgb(20, 20, 20));
}

.page-template-root {
    flex-grow: 1;
    justify-content: flex-start;
}

/* A panel's navigation reaches out to the frame line, so the headers it clips while paging
   stay flush; its pages pad their content back in */
.menu-root > .nav-view {
    margin-top: var(--panel-frame-gap-negative);
    margin-left: var(--panel-frame-gap-negative);
    margin-right: var(--panel-frame-gap-negative);
}

.menu-root > .nav-view .page-template-root {
    padding-left: var(--panel-frame-gap);
    padding-right: var(--panel-frame-gap);
}

.menu-root > .nav-view .nav-header {
    margin-top: 0;
}

/* Solid bar flush with the panel's frame line */
.nav-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: var(--control-min-height, 46px);
    margin-top: var(--panel-frame-gap-negative);
    margin-left: var(--panel-frame-gap-negative);
    margin-right: var(--panel-frame-gap-negative);
    margin-bottom: var(--spacing-large, 12px);
    padding-left: var(--spacing-small, 4px);
    padding-right: var(--spacing-medium, 8px);
    background-color: var(--primary);
}

.title,
.nav-header__title {
    -unity-text-align: middle-left;
    font-size: var(--font-size-title, 32px);
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/DINishCondensed-Light.ttf?fileID=12800000&guid=67a02d15b790b4aa98aa67d81f08ef7c&type=3#DINishCondensed-Light");
}

/* Cap height fills the nav bar */
.unity-label.nav-header__title {
    --text-color: var(--secondary);
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    margin: 0;
    font-size: var(--font-size-nav-title, 38px);
    -unity-text-align: middle-right;
    overflow: visible;
}

.nav-header--without-back-button > .unity-label.nav-header__title {
    -unity-text-align: middle-left;
    margin-left: var(--spacing-small, 4px);
}

.nav-button {
    background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/chevron.svg?fileID=7388822144124034973&guid=0fd51030a512546328cc9361346e77b8&type=3#chevron");
    background-size: auto 16px;
    background-position-x: right 12px;
    background-position-y: center;
    background-repeat: no-repeat;
    padding-right: 40px;
}

.nav-button.nav-header__back-button {
    background-position-x: center;
    background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/back%20chevron.svg?fileID=7388822144124034973&guid=ce2a202a9449e49a38f514f72b39cc20&type=3#back chevron");
    width: var(--header-button-size);
    height: var(--header-button-size);
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    margin-right: var(--spacing-large, 12px);
}

.unity-button.nav-header__back-button {
    background-color: var(--secondary);
    -unity-background-image-tint-color: var(--primary);
}

.unity-button.nav-header__back-button:hover {
    background-color: var(--highlight);
    -unity-background-image-tint-color: var(--secondary);
}

/* Option control: label, chosen value beneath, marks on the right */

.unity-base-field.detent-field {
    --text-color: var(--primary);
    height: 52px;
    margin-top: var(--spacing-large, 12px);
    margin-bottom: var(--spacing-large, 12px);
    margin-left: var(--spacing-small, 4px);
    margin-right: var(--spacing-small, 4px);
    padding: 0;
    flex-direction: column;
    justify-content: center;
}

.detent-field > .unity-base-field__label {
    min-width: auto;
    width: auto;
    margin: 0;
    padding: 0;
    color: var(--primary);
    font-size: var(--font-size-body, 20px);
    -unity-font-definition: var(--font-light);
}

/* Pulls the value up under the label: their line boxes are taller than the glyphs */
.detent-field > .detent-field__value {
    margin: 0;
    margin-top: -6px;
    color: white;
    font-size: var(--font-size-title, 32px);
    -unity-font-definition: var(--font-bold);
}

.detent-field > .detent-field__marks {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    /* 20 ticks of 4px leave 19 whole 6px gaps, so they space evenly */
    width: 194px;
    margin: 0;
    flex-direction: row;
    justify-content: flex-end;
    background-color: transparent;
}

.detent-field > .detent-field__marks--ticks {
    justify-content: space-between;
}

/* Icons tint with the mark color; ticks and bar segments fill with it */
.detent-field__mark {
    --mark-color: var(--disabled);
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--mark-color);
}

.detent-field__mark--lit {
    --mark-color: var(--primary);
}

/* Hover marks choices up to the pointer */
.detent-field__mark--hovered {
    --mark-color: var(--highlight);
}

.detent-field__tick {
    width: 4px;
    background-color: var(--mark-color);
}

.detent-field__segment {
    flex-basis: 0;
    margin-left: 2px;
    margin-right: 2px;
    background-color: var(--mark-color);
}

.field-row {
    margin-top: var(--spacing-small, 4px);
    margin-bottom: var(--spacing-small, 4px);
}

.warning {
    color: rgb(255, 210, 80);
    white-space: normal;
}

.error-subject {
    flex-grow: 0;
    -unity-font-definition: var(--font-bold);
    white-space: normal;
    margin-bottom: var(--spacing-small, 4px);
}

.body-copy {
    white-space: normal;
    margin-top: var(--spacing-medium, 8px);
    margin-bottom: var(--spacing-medium, 8px);
}

.version {
    margin-top: auto;
    font-size: var(--font-size-small, 14px);
    white-space: normal;
}

.unity-button {
    --text-color: var(--secondary, rgb(20, 20, 20));
    border-width: 0;
    -unity-text-align: middle-left;
    -unity-font-definition: var(--font-bold);
    background-color: var(--primary, rgb(200, 200, 200));
    color: var(--text-color);
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
}

.unity-button:hover {
    background-color: var(--highlight);
}

.unity-button:disabled {
    background-color: var(--disabled);
    opacity: 1;
}

/* Pressed buttons blink out and back, whatever their own colors */
.press-flash {
    opacity: 0;
}

.unity-button.option--selected,
.unity-button.option--selected:hover {
    background-color: white;
}

*.unity-button.destructive {
    --primary: rgb(255, 50, 50);
    --highlight: rgb(255, 150, 150);
    --secondary: rgb(50, 10, 10);
}

.unity-button,
Toggle,
TextField,
.unity-popup-field {
    margin-top: var(--spacing-small, 4px);
    margin-bottom: var(--spacing-small, 4px);
    font-size: var(--font-size-body, 20px);
    justify-content: center;
}

.unity-popup-field > .unity-popup-field__input {
    --text-color: var(--secondary, rgb(20, 20, 20));
    min-height: var(--control-min-height, 46px);
    padding: 0;
    padding-left: var(--spacing-medium, 8px);
    padding-right: var(--spacing-medium, 8px);
    background-color: var(--primary, rgb(150, 150, 150));
    border-color: var(--primary, rgb(150, 150, 150));
    border-width: var(--control-border-width, 1px);
}

.unity-popup-field:hover:enabled > .unity-popup-field__input,
.unity-popup-field:focus:enabled > .unity-popup-field__input {
    background-color: var(--highlight);
    border-color: var(--highlight);
}

.unity-popup-field .unity-base-popup-field__input {
    margin-left: 0;
}

.unity-popup-field .unity-base-popup-field__text {
    font-size: var(--font-size-body, 20px);
    color: var(--secondary, rgb(20, 20, 20));
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    -unity-font-definition: var(--font-bold);
}

.unity-popup-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
    flex-shrink: 0;
    margin-left: var(--spacing-medium, 8px);
}

.unity-base-dropdown {
    --primary: rgb(150, 150, 150);
    --secondary: rgb(20, 20, 20);
}

.unity-base-dropdown * {
    -unity-font-definition: var(--font-bold);
}

.unity-base-dropdown .unity-base-dropdown__container-outer {
    background-color: var(--secondary, rgb(20, 20, 20));
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
    padding: var(--spacing-small, 4px);
}

.unity-base-dropdown .unity-base-dropdown__container-inner {
    background-color: var(--secondary, rgb(20, 20, 20));
}

.unity-base-dropdown .unity-base-dropdown__item {
    --text-color: var(--secondary, rgb(20, 20, 20));
    min-height: var(--control-min-height, 46px);
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-base-dropdown .unity-base-dropdown__item:checked {
    background-color: var(--highlight);
}

.unity-base-dropdown .unity-base-dropdown__item:hover:enabled,
.unity-base-dropdown .unity-base-dropdown__item:focus:enabled {
    background-color: var(--highlight);
}

.unity-base-dropdown .unity-base-dropdown__label {
    font-size: var(--font-size-body, 20px);
    color: var(--secondary, rgb(20, 20, 20));
    -unity-text-align: middle-left;
}

.unity-base-dropdown .unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
}

.unity-base-dropdown .unity-base-dropdown__separator {
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-label {
    margin: var(--spacing-small, 4px);
    padding: 0;
}

.touch-screen Toggle {
    min-height: var(--control-min-height, 46px);
    align-items: center;
}

.unity-toggle__text {
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
}

ScrollView {
    flex-grow: 1;
    padding: 0;
}

ScrollView .unity-scroll-view__content-container {
    padding: 0;
}

ScrollView .unity-scroll-view__vertical-scroller {
    width: var(--scrollbar-size, 24px);
    margin-left: var(--spacing-small, 4px);
    margin-right: 0;
}

ScrollView .unity-scroll-view__horizontal-scroller {
    height: var(--scrollbar-size, 24px);
    margin-top: var(--spacing-small, 4px);
    margin-bottom: 0;
}

ScrollView #unity-low-button,
ScrollView #unity-high-button {
    min-width: var(--scrollbar-size, 24px);
    max-width: var(--scrollbar-size, 24px);
    min-height: var(--scrollbar-size, 24px);
    max-height: var(--scrollbar-size, 24px);
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    translate: 0 0 0;
    background-color: var(--primary, rgb(150, 150, 150));
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
}

ScrollView #unity-low-button:hover,
ScrollView #unity-high-button:hover {
    background-color: var(--highlight);
    border-color: var(--highlight);
}

ScrollView .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
    margin-top: var(--scrollbar-button-clearance, 28px);
    margin-bottom: var(--scrollbar-button-clearance, 28px);
}

ScrollView .unity-scroller--horizontal > .unity-scroller__slider {
    margin: 0;
    margin-left: var(--scrollbar-button-clearance, 28px);
    margin-right: var(--scrollbar-button-clearance, 28px);
}

ScrollView .unity-scroller__slider #unity-tracker {
    margin: 0;
}

ScrollView .unity-scroller__slider #unity-dragger {
    margin: 0;
}

ScrollView .unity-scroller__slider #unity-dragger-border {
    background-color: transparent;
    border-width: 0;
}

ScrollView .unity-scroll-view__vertical-scroller #unity-drag-container,
ScrollView .unity-scroll-view__vertical-scroller #unity-dragger {
    min-width: var(--scrollbar-size, 24px);
    max-width: var(--scrollbar-size, 24px);
    align-self: center;
}

ScrollView .unity-scroll-view__vertical-scroller #unity-dragger {
    left: 0;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-drag-container,
ScrollView .unity-scroll-view__horizontal-scroller #unity-dragger {
    min-height: var(--scrollbar-size, 24px);
    max-height: var(--scrollbar-size, 24px);
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-drag-container {
    align-self: center;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-dragger {
    top: 0;
}

.stacked-field.unity-base-slider #unity-tracker {
    height: 10px;
    margin-top: -5px;
}

.stacked-field.unity-base-slider #unity-dragger {
    margin-top: -18px;
    height: 36px;
}

.stacked-field {
    flex-direction: column;
    align-items: stretch;
}

.stacked-field .unity-base-field__label {
    min-width: auto;
    width: auto;
    margin: 0;
}

.unity-base-field {
    margin: var(--spacing-small, 4px);
}

.stacked-field .unity-base-slider__input {
    max-height: 36px;
    flex-grow: 0;
    margin: 0;
}

.stacked-field .unity-base-slider__text-field {
    flex-grow: 0;
    width: 72px;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 0;
}

.stacked-field .unity-radio-button-group__container {
    flex-direction: row;
    flex-wrap: wrap;
}

.unity-tab__header {
    --text-color: var(--secondary, rgb(20, 20, 20));
    background-color: var(--primary, rgb(150, 150, 150));
    border-width: var(--control-border-width, 1px);
    border-bottom-width: 0;
    border-color: var(--primary, rgb(150, 150, 150));
    min-height: var(--control-min-height, 46px);
    font-size: var(--font-size-body, 20px);
    padding: 0;
    padding-left: var(--spacing-large, 12px);
    padding-right: var(--spacing-large, 12px);
    margin-right: var(--spacing-small, 4px);
    justify-content: center;
}

.unity-tab__header:checked,
.unity-tab__header:hover:enabled {
    background-color: var(--highlight);
}

.unity-tab__header-label {
    -unity-text-align: middle-center;
    margin: 0;
    color: var(--secondary, rgb(20, 20, 20));
}

.unity-tab__header-underline {
    display: none;
}

.unity-tab-view__content-viewport {
    background-color: transparent;
}

.unity-tab-view__header-container {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: var(--control-border-width, 1px);
    border-bottom-color: var(--primary, rgb(150, 150, 150));
    width: 100%;
}

.unity-tab__content-container {
    flex-grow: 1;
    padding-top: var(--spacing-medium, 8px);
}

.unity-tab-view__content-container,
.unity-tab {
    flex-grow: 1;
    min-height: 0;
}

.unity-multi-column-header {
    min-height: auto;
}

.unity-multi-column-header,
.unity-multi-column-header__column,
.unity-multi-column-header__column__content-container {
    --text-color: var(--secondary, rgb(20, 20, 20));
    background-color: var(--primary, rgb(150, 150, 150));
    border-color: var(--primary, rgb(150, 150, 150));
}

.unity-multi-column-header__column:hover,
.unity-multi-column-header__column:hover .unity-multi-column-header__column__content-container {
    background-color: var(--highlight);
}

.unity-multi-column-header__column__title {
    color: var(--secondary, rgb(20, 20, 20));
}

.unity-collection-view__item:hover:enabled,
.unity-collection-view__item--selected {
    --text-color: var(--secondary, rgb(20, 20, 20));
    background-color: var(--highlight);
}

.unity-two-pane-split-view__dragline-anchor {
    position: absolute;
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-two-pane-split-view__dragline-anchor:hover {
    background-color: var(--highlight);
}

.unity-two-pane-split-view__dragline-anchor--horizontal {
    width: 4px;
    height: 100%;
}

.unity-two-pane-split-view__dragline-anchor--vertical {
    height: 4px;
    width: 100%;
}

.unity-two-pane-split-view__dragline--horizontal {
    position: absolute;
    width: 12px;
    height: 100%;
    left: -4px;
}

.unity-two-pane-split-view__dragline--vertical {
    position: absolute;
    height: 12px;
    width: 100%;
    top: -4px;
}

.chip {
    margin-right: var(--spacing-small, 4px);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    color: rgb(0, 12, 24);
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
}

.chip--good {
    background-color: rgb(76, 196, 112);
}

.chip--fair {
    background-color: rgb(226, 199, 74);
}

.chip--low {
    background-color: rgb(238, 148, 58);
}

.chip--critical {
    background-color: rgb(228, 79, 70);
}

.chip--unknown {
    background-color: rgb(86, 102, 118);
    color: rgb(214, 229, 245);
}

.team-red {
    color: rgb(255, 0, 38);
}

.team-blue {
    color: rgb(0, 191, 255);
}

.team-red-bg {
    background-color: rgb(255, 0, 38);
}

.team-blue-bg {
    background-color: rgb(0, 191, 255);
}

/* Camera mode: a phone filming the game */

.camera-mode {
    --primary: rgb(200, 200, 200);
    --secondary: rgb(20, 20, 20);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: black;
}

.camera-mode-view {
    position: absolute;
}

.camera-mode-bar {
    position: absolute;
    align-items: center;
    justify-content: space-between;
}

.camera-mode-bar-slot {
    width: 96px;
    height: 72px;
    align-items: center;
    justify-content: center;
}

.camera-mode-done {
    min-width: 96px;
    min-height: var(--control-min-height, 46px);
    margin: 0;
    border-width: var(--panel-border-width, 2px);
    border-color: var(--primary);
    background-color: var(--secondary);
    color: white;
    -unity-text-align: middle-center;
}

.camera-mode-record {
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    border-width: 4px;
    border-color: white;
    background-color: rgba(0, 0, 0, 0.4);
}

.camera-mode-record-core {
    width: 52px;
    height: 52px;
    background-color: rgb(255, 0, 38);
    transition-property: width, height;
    transition-duration: 0.12s;
}

.camera-mode-record--recording > .camera-mode-record-core {
    width: 26px;
    height: 26px;
}

.camera-mode-record--busy {
    opacity: 0.4;
}

.camera-mode-status {
    position: absolute;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.camera-mode-status > .chip {
    margin-left: var(--spacing-small, 4px);
    font-size: var(--font-size-body, 20px);
}

.camera-mode-status > .camera-mode-chip--switchable {
    padding-top: var(--spacing-medium, 8px);
    padding-bottom: var(--spacing-medium, 8px);
    padding-left: var(--spacing-large, 12px);
    padding-right: var(--spacing-large, 12px);
    background-color: var(--secondary);
    border-width: var(--panel-border-width, 2px);
    border-color: var(--primary);
    color: white;
}

.camera-mode-message {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    color: white;
    font-size: var(--font-size-body, 20px);
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
    text-shadow: 0 0 4px black;
}
