/* Global defaults */

* {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/DINish-Regular%20SDF.asset?fileID=11400000&guid=8605ad9ed578841b0960a34a3cc63844&type=2#DINish-Regular SDF");
    color: rgb(255, 255, 255);
}

/* Menu shell and panel themes */

.menu-root {
    flex-grow: 1;
    padding: 4px;
    background-color: rgb(20, 20, 20);
    color: rgb(255, 255, 255);
    font-size: 20px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.multiplayer-panel {
    border-color: rgb(255, 0, 21);
    background-color: rgb(27, 0, 33);
}

.game-panel {
    border-color: rgb(0, 255, 173);
    background-color: rgb(0, 14, 49);
}

.settings-panel {
    border-color: rgb(255, 116, 0);
    background-color: rgb(24, 36, 0);
}

/* Control visuals */

.unity-toggle__checkmark,
.nav-header__back-button {
    margin-right: 10px;
}

.unity-base-text-field > .unity-base-text-field__input,
.unity-popup-field > .unity-popup-field__input,
.unity-toggle > .unity-toggle__input > .unity-toggle__checkmark,
.unity-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

.stacked-field.unity-base-slider #unity-tracker {
    background-color: transparent;
    border-width: 1px;
    border-color: white;
    height: 10px;
    margin-top: -5px;
}

.stacked-field.unity-base-slider #unity-dragger {
    background-color: white;
    border-width: 0;
    margin-top: -18px;
    height: 36px;
}

.stacked-field.unity-base-slider #unity-fill {
    background-color: white;
}

RadioButton .unity-radio-button__checkmark-background {
    background-color: transparent;
    border-width: 1px;
    border-color: white;
    padding: 0;
}

RadioButton #unity-checkmark {
    width: 100%;
    height: 100%;
    background-color: white;
    border-radius: 100%;
}

.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: none;
    background-color: rgb(230, 230, 230);
}

/* Navigation and page layout */

.nav-view,
.nav-page,
.nav-page > TemplateContainer {
    flex-grow: 1;
}

.nav-page {
    justify-content: flex-start;
}

.page-template-root {
    flex-grow: 1;
    justify-content: flex-start;
}

.nav-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.title,
.nav-header__title {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/DINishExpanded-Regular%20SDF.asset?fileID=11400000&guid=7dfaad12b4ec34f0bbdc86faea4b3721&type=2#DINishExpanded-Regular SDF");
}

.nav-button {
	background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/HUD/Graphics/chevron.svg");
	background-size: auto 16px;
	background-position-x: right 12px;
	background-position-y: center;
	background-repeat: no-repeat;
	-unity-background-image-tint-color: white;
	
	padding-right: 40px;
}

/* Shared page content */

.field-row {
    margin-top: 4px;
    margin-bottom: 4px;
}

.warning {
    color: rgb(255, 210, 80);
    white-space: normal;
}

.error-subject {
    flex-grow: 0;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.body-copy {
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 8px;
}

.map-row {
    white-space: normal;
    -unity-text-align: middle-left;
    align-self: stretch;
}

.map-row.selected {
    background-color: rgb(230, 230, 230);
    color: rgb(0, 14, 49);
}

#map-list {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

.version {
    margin-top: auto;
    font-size: 14px;
    white-space: normal;
}

/* Shared control sizing and spacing */

.unity-button {
    -unity-text-align: middle-left;
    background-color: rgb(70, 70, 70);
}

.unity-button.destructive {
    background-color: rgb(60, 14, 0);
    border-color: rgb(255, 0, 0);
}

.unity-button,
Toggle,
TextField,
.unity-popup-field {
    margin-top: 4px;
    margin-bottom: 4px;
    font-size: 20px;
    /*translate: 0 0 5px;*/
    justify-content: center;
}

/* Popup fields (including DropdownField) */

.unity-popup-field > .unity-popup-field__input {
    min-height: 46px;
    padding: 0 8px;
    background-color: rgb(70, 70, 70);
}

.unity-popup-field:hover:enabled > .unity-popup-field__input,
.unity-popup-field:focus:enabled > .unity-popup-field__input {
    background-color: rgb(90, 90, 90);
}

.unity-popup-field .unity-base-popup-field__text {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.unity-popup-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    margin-left: 8px;
}

/* Open dropdowns are panel overlays, not children of their popup fields. */

.unity-base-dropdown .unity-base-dropdown__container-outer {
    background-color: rgb(20, 20, 20);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    padding: 4px;
}

.unity-base-dropdown .unity-base-dropdown__container-inner {
    background-color: rgb(20, 20, 20);
}

.unity-base-dropdown .unity-base-dropdown__item {
    min-height: 46px;
    background-color: rgb(20, 20, 20);
}

.unity-base-dropdown .unity-base-dropdown__item:checked {
    background-color: rgb(70, 70, 70);
}

.unity-base-dropdown .unity-base-dropdown__item:hover:enabled,
.unity-base-dropdown .unity-base-dropdown__item:focus:enabled {
    background-color: rgb(90, 90, 90);
}

.unity-base-dropdown .unity-base-dropdown__label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
}

.unity-base-dropdown .unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-base-dropdown .unity-base-dropdown__separator {
    background-color: rgba(255, 255, 255, 0.4);
}

.unity-label {
    margin: 4px;
    padding: 0;
}

.unity-toggle__text {
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.permission-toggle.permission-granted:disabled {
    opacity: 1;
}

ScrollView {
    flex-grow: 1;
}

/* Scroll bars */

ScrollView .unity-scroll-view__vertical-scroller {
    width: 24px;
    margin-left: 4px;
	margin-right: 4px;
}

ScrollView .unity-scroll-view__horizontal-scroller {
    height: 24px;
    margin-top: 4px;
	margin-bottom: 4px;
}

ScrollView #unity-low-button,
ScrollView #unity-high-button {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    translate: 0 0 0;
    background-color: rgb(70, 70, 70);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

ScrollView #unity-low-button:hover,
ScrollView #unity-high-button:hover {
    background-color: rgb(90, 90, 90);
}

ScrollView .unity-scroller--vertical > .unity-scroller__slider {
    margin: 28px 0;
}

ScrollView .unity-scroller--horizontal > .unity-scroller__slider {
    margin: 0 28px;
}

ScrollView .unity-scroller__slider #unity-tracker {
    margin: 0;
    background-color: transparent;
    border-width: 1px;
	border-color: rgb(255, 255, 255);
}

ScrollView .unity-scroller__slider #unity-dragger {
    margin: 0;
    background-color: rgb(255, 255, 255);
    border-width: 0;
}

ScrollView .unity-scroller__slider #unity-dragger-border {
    background-color: transparent;
    border-width: 0;
}

ScrollView .unity-scroll-view__vertical-scroller #unity-drag-container,
ScrollView .unity-scroll-view__vertical-scroller #unity-dragger {
    min-width: 24px;
    max-width: 24px;
    align-self: center;
}

ScrollView .unity-scroll-view__vertical-scroller #unity-dragger {
    left: 0;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-drag-container,
ScrollView .unity-scroll-view__horizontal-scroller #unity-dragger {
    min-height: 8px;
    max-height: 8px;
    align-self: center;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-dragger {
    top: 0;
}

.nav-header__back-button {
	background-position-x: center;
	background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/HUD/Graphics/back chevron.svg");
	padding:18px;
    aspect-ratio: 1;
    min-height: auto;
}

/* Stacked form fields */

.stacked-field {
    flex-direction: column;
    align-items: stretch;
}

.stacked-field .unity-base-field__label {
    min-width: auto;
    width: auto;
    margin: 0;
}

.unity-base-field {
    margin: 4px;
}

.stacked-field .unity-base-slider__input {
    max-height: 36px;
    flex-grow: 0;
    margin: 0;
}

.stacked-field .unity-base-slider__text-field {
    flex-grow: 0;
    width: 72px;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 0;
}

.stacked-field .unity-radio-button-group__container {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Tab view */

.unity-tab__header {
    background-color: rgb(70, 70, 70);
    border-width: 1px 1px 0 1px;
    border-color: rgb(255, 255, 255);
    min-height: 46px;
    font-size: 20px;
    padding: 0 12px;
    margin-right: 4px;
    justify-content: center;
}

.unity-tab__header:checked {
    background-color: rgb(255, 255, 255);
}

.unity-tab__header:checked .unity-tab__header-label {
    color: rgb(0, 14, 49);
}

.unity-tab__header-label {
    -unity-text-align: middle-center;
    margin: 0;
}

.unity-tab__header-underline {
    display: none;
}

.unity-tab-view__header-container {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgb(255, 255, 255);
	width: 100%;
}

.unity-tab__content-container {
    flex-grow: 1;
    padding-top: 8px;
}

/* Console */

.console-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    background-color: rgba(0, 0, 0, 0.5);
    padding: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.console-entry {
    font-size: 14px;
    white-space: normal;
    margin-bottom: 6px;
}

.console-entry.console-entry-warning {
    color: rgb(255, 210, 80);
}

.console-entry.console-entry-error {
    color: rgb(255, 130, 130);
}

.console-controls {
    flex-direction: row;
    align-items: center;
}

.console-controls > Toggle {
    flex-grow: 1;
}

.console-clear-button {
    width: 130px;
    margin-left: 8px;
    -unity-text-align: middle-center;
}

/* Map editor palette */

.palette-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.palette-rail {
    flex-grow: 0;
    flex-shrink: 0;
    width: 84px;
    margin-right: 8px;
}

.palette-content {
    flex-grow: 1;
    min-width: 0;
}

.palette-title {
    font-size: 26px;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

/* Palette tools and object grid */

.palette-tools {
    flex-direction: row;
}

.palette-tool {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 38px;
    font-size: 16px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-text-align: middle-center;
}

.palette-grid {
    flex-grow: 1;
    min-height: 0;
}

.palette-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.palette-tab,
.palette-item {
    align-items: center;
    justify-content: flex-start;
    min-height: auto;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.35);
}

.palette-tab {
    margin: 0 0 6px 0;
}

.palette-item {
    width: 30%;
    margin: 4px;
}

.palette-tab-icon,
.palette-item-icon {
    background-color: rgba(255, 255, 255, 0.07);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.palette-tab-icon {
    width: 44px;
    height: 44px;
}

.palette-item-icon {
    width: 100%;
    aspect-ratio: 1;
}

.palette-tab-label,
.palette-item-label {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.palette-tab-label {
    font-size: 11px;
}

.palette-item-label {
    font-size: 14px;
}

.palette-tab.selected,
.palette-item.selected,
.palette-tool.selected {
    background-color: rgb(230, 230, 230);
}

.palette-tool.selected,
.palette-tab.selected .palette-tab-label,
.palette-item.selected .palette-item-label {
    color: rgb(0, 14, 49);
}

.palette-tab.selected .palette-tab-icon,
.palette-item.selected .palette-item-icon {
    background-color: rgba(0, 0, 0, 0.1);
}

/* Palette forms */

.palette-form {
    padding: 4px 2px;
}

.palette-form .unity-scroll-view__content-container {
    flex-direction: column;
    flex-wrap: nowrap;
}

.palette-hint {
    opacity: 0.7;
}

/* Game mode picker */

.palette-mode-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.palette-mode {
    width: 30%;
    margin: 4px;
    align-items: center;
    justify-content: flex-start;
    min-height: auto;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.35);
}

.palette-mode-icon {
    width: 100%;
    aspect-ratio: 1;
    background-color: rgba(255, 255, 255, 0.07);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.palette-mode-label {
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.palette-done {
    align-self: center;
    min-width: 140px;
    -unity-text-align: middle-center;
}

/* Full-screen HUD */

.hud-root {
    flex-grow: 1;
    color: rgb(255, 255, 255);
}

.hud-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.team-red {
    color: rgb(255, 0, 38);
}

.team-blue {
    color: rgb(0, 191, 255);
}

.team-red-bg {
    background-color: rgb(255, 0, 38);
}

.team-blue-bg {
    background-color: rgb(0, 191, 255);
}

/* Death and respawn */

.you-died-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.you-died-label {
    font-size: 60px;
    color: rgb(255, 119, 119);
    -unity-text-align: middle-center;
}

.death-bar {
    width: 94px;
    height: 30px;
    background-color: rgb(255, 120, 120);
}

.respawn-label {
    font-size: 30px;
    -unity-text-align: middle-center;
}

/* Queue and countdown */

.queue-label {
    font-size: 30px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.countdown-label {
    position: absolute;
    font-size: 140px;
    -unity-text-align: middle-center;
}

/* Round results */

.results-title {
    font-size: 60px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.results-round-label {
    font-size: 30px;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.results-scores {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.results-score {
    font-size: 60px;
    width: 200px;
}

.vs-label {
    font-size: 60px;
    width: 100px;
    -unity-text-align: middle-center;
}

/* Connection status */

.connection-label {
    font-size: 45px;
    -unity-text-align: middle-center;
}
