/* Global defaults */

* {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/DINish-Regular%20SDF.asset");
    color: var(--text-color, rgb(255, 255, 255));

	--spacing-small: 4px;
	--spacing-medium: 8px;
	--spacing-large: 12px;
	--control-icon-spacing: 10px;
	--font-size-body: 20px;
	--font-size-title: 28px;
	--font-size-small: 14px;
	--control-min-height: 46px;
	--control-border-width: 1px;
	--panel-border-width: 2px;
	--scrollbar-size: 24px;
	--scrollbar-button-clearance: 28px;
}

/* Shared spacing and control sizes */

/*.menu-root,*/
/*.unity-base-dropdown {*/
/*    --spacing-small: 4px;*/
/*    --spacing-medium: 8px;*/
/*    --spacing-large: 12px;*/
/*    --control-icon-spacing: 10px;*/
/*    --font-size-body: 20px;*/
/*    --font-size-title: 28px;*/
/*    --font-size-small: 14px;*/
/*    --control-min-height: 46px;*/
/*    --control-border-width: 1px;*/
/*    --panel-border-width: 2px;*/
/*    --scrollbar-size: 24px;*/
/*    --scrollbar-button-clearance: 28px;*/
/*}*/

/* Menu shell and panel themes */

.menu-root {
    --primary: rgb(200, 200, 200);
    --highlight: rgb(220, 220, 220);
    --secondary: rgb(20, 20, 20);

    flex-grow: 1;
    padding: var(--spacing-small, 4px);
    background-color: var(--secondary);
    color: rgb(255, 255, 255);
    font-size: var(--font-size-body, 20px);
    border-width: var(--panel-border-width, 2px);
    border-color: var(--primary);
}

.multiplayer-panel {
    --primary: rgb(255, 0, 21);
	--primary-dark: rgb(200, 0, 1);
	--highlight: rgb(255, 128, 140);
    --secondary: rgb(27, 0, 33);
}

.multiplayer-panel.session-connected {
    --primary: rgb(162, 255, 0);
	--primary-dark: rgb(128, 204, 0);
	--highlight: rgb(207, 255, 128);
    --secondary: rgb(27, 30, 0);
}

.game-panel {
    --primary: rgb(0, 255, 173);
	--primary-dark: rgb(0, 205, 140);
	--highlight: rgb(177, 255, 230);
    --secondary: rgb(12, 0, 49);
}

.settings-panel {
    --primary: rgb(255, 116, 0);
	--primary-dark: rgb(189, 88, 0);
	--highlight: rgb(255, 185, 127);
    --secondary: rgb(41, 37, 0);
}

/* Inputs and toggles */

.unity-toggle__checkmark,
.nav-header__back-button {
    margin-right: var(--control-icon-spacing, 10px);
}

.unity-base-text-field > .unity-base-text-field__input {
    --text-color: white;
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
    color: white;
}

.unity-base-text-field:hover:enabled > .unity-base-text-field__input,
.unity-base-text-field:focus:enabled > .unity-base-text-field__input,
.unity-base-text-field > .unity-base-text-field__input:focus {
    border-color: var(--highlight, rgb(255, 255, 255));
}

.unity-toggle,
.unity-radio-button {
    --text-color: white;
    --selection-outline: var(--primary, rgb(150, 150, 150));
}

.unity-toggle:hover:enabled,
.unity-toggle:focus:enabled,
.unity-radio-button:hover:enabled,
.unity-radio-button:focus:enabled {
    --selection-outline: var(--highlight, rgb(255, 255, 255));
}

.unity-toggle__input:checked,
.unity-radio-button__input:checked {
    --selection-outline: white;
}

.unity-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--selection-outline);
}

.unity-base-slider #unity-tracker {
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
}

.unity-base-slider #unity-dragger {
    background-color: var(--primary, rgb(150, 150, 150));
    border-width: 0;
}

.unity-base-slider #unity-fill {
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-base-slider:hover:enabled #unity-dragger,
.unity-base-slider:focus:enabled #unity-dragger {
    background-color: var(--highlight, rgb(255, 255, 255));
}

RadioButton .unity-radio-button__checkmark-background {
    background-color: transparent;
    border-width: var(--control-border-width, 1px);
    border-color: var(--selection-outline);
    padding: 0;
}

RadioButton #unity-checkmark {
    width: 100%;
    height: 100%;
    background-color: white;
    border-radius: 100%;
}

.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: none;
    background-color: white;
}

/* Navigation and page layout */

.menu-root .nav-view {
    --nav-transition-duration-ms: 100;
}

.nav-view,
.nav-page,
.nav-page > TemplateContainer {
    flex-grow: 1;
}

.nav-page {
    justify-content: flex-start;
}

.nav-page--modal-transition {
    background-color: var(--secondary, rgb(20, 20, 20));
}

.page-template-root {
    flex-grow: 1;
    justify-content: flex-start;
}

.nav-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-medium, 8px);
}

.title,
.nav-header__title {
    -unity-text-align: middle-left;
    font-size: var(--font-size-title, 28px);
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/DINishCondensed-Light%20SDF.asset");
}

.nav-button {
    background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/chevron.svg");
    background-size: auto 16px;
    background-position-x: right 12px;
    background-position-y: center;
    background-repeat: no-repeat;
    padding-right: 40px;
}

.nav-header__back-button {
    background-position-x: center;
    background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/back chevron.svg");
    padding: 18px;
    aspect-ratio: 1;
    min-height: auto;
}

/* Shared page content */

.field-row {
    margin-top: var(--spacing-small, 4px);
    margin-bottom: var(--spacing-small, 4px);
}

.warning {
    color: rgb(255, 210, 80);
    white-space: normal;
}

.error-subject {
    flex-grow: 0;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: var(--spacing-small, 4px);
}

.body-copy {
    white-space: normal;
    margin-top: var(--spacing-medium, 8px);
    margin-bottom: var(--spacing-medium, 8px);
}

.version {
    margin-top: auto;
    font-size: var(--font-size-small, 14px);
    white-space: normal;
}

/* Buttons and shared control spacing */

.unity-button {
    --text-color: var(--secondary, rgb(20, 20, 20));
    border-width: 0;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    background-color: var(--primary, rgb(200, 200, 200));
    color: var(--text-color);
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
}

.unity-button:hover {
    background-color: var(--highlight, rgb(255, 255, 255));
}

*.unity-button.destructive {
	--primary: rgb(255, 50, 50);
	--highlight: rgb(255, 150, 150);
	--secondary: rgb(50, 10, 10);
}

.unity-button,
Toggle,
TextField,
.unity-popup-field {
    margin-top: var(--spacing-small, 4px);
    margin-bottom: var(--spacing-small, 4px);
    font-size: var(--font-size-body, 20px);
    justify-content: center;
}

/* Popup fields (including DropdownField) */

.unity-popup-field > .unity-popup-field__input {
    --text-color: var(--secondary, rgb(20, 20, 20));
    min-height: var(--control-min-height, 46px);
    padding: 0;
    padding-left: var(--spacing-medium, 8px);
    padding-right: var(--spacing-medium, 8px);
    background-color: var(--primary, rgb(150, 150, 150));
    border-color: var(--primary, rgb(150, 150, 150));
    border-width: var(--control-border-width, 1px);
}

.unity-popup-field:hover:enabled > .unity-popup-field__input,
.unity-popup-field:focus:enabled > .unity-popup-field__input {
    background-color: var(--highlight, rgb(255, 255, 255));
    border-color: var(--highlight, rgb(255, 255, 255));
}

.unity-popup-field .unity-base-popup-field__input {
    margin-left: 0;
}

.unity-popup-field .unity-base-popup-field__text {
    font-size: var(--font-size-body, 20px);
    color: var(--secondary, rgb(20, 20, 20));
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
	-unity-font-style: bold;
}

.unity-popup-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
    flex-shrink: 0;
    margin-left: var(--spacing-medium, 8px);
}

/* Open dropdowns are panel overlays, not children of their popup fields. */

.unity-base-dropdown {
    --primary: rgb(150, 150, 150);
    --highlight: rgb(200, 200, 200);
    --secondary: rgb(20, 20, 20);
	-unity-font-style: bold;
}

.unity-base-dropdown .unity-base-dropdown__container-outer {
    background-color: var(--secondary, rgb(20, 20, 20));
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
    padding: var(--spacing-small, 4px);
}

.unity-base-dropdown .unity-base-dropdown__container-inner {
    background-color: var(--secondary, rgb(20, 20, 20));
}

.unity-base-dropdown .unity-base-dropdown__item {
    --text-color: var(--secondary, rgb(20, 20, 20));
    min-height: var(--control-min-height, 46px);
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-base-dropdown .unity-base-dropdown__item:checked {
    background-color: var(--highlight, rgb(255, 255, 255));
}

.unity-base-dropdown .unity-base-dropdown__item:hover:enabled,
.unity-base-dropdown .unity-base-dropdown__item:focus:enabled {
    background-color: var(--highlight, rgb(255, 255, 255));
}

.unity-base-dropdown .unity-base-dropdown__label {
    font-size: var(--font-size-body, 20px);
    color: var(--secondary, rgb(20, 20, 20));
    -unity-text-align: middle-left;
}

.unity-base-dropdown .unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
}

.unity-base-dropdown .unity-base-dropdown__separator {
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-label {
    margin: var(--spacing-small, 4px);
    padding: 0;
}

.unity-toggle__text {
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
}

ScrollView {
    flex-grow: 1;
}

/* Scroll bars */

ScrollView .unity-scroll-view__vertical-scroller {
    width: var(--scrollbar-size, 24px);
    margin-left: var(--spacing-small, 4px);
    margin-right: var(--spacing-small, 4px);
}

ScrollView .unity-scroll-view__horizontal-scroller {
    height: var(--scrollbar-size, 24px);
    margin-top: var(--spacing-small, 4px);
    margin-bottom: var(--spacing-small, 4px);
}

ScrollView #unity-low-button,
ScrollView #unity-high-button {
    min-width: var(--scrollbar-size, 24px);
    max-width: var(--scrollbar-size, 24px);
    min-height: var(--scrollbar-size, 24px);
    max-height: var(--scrollbar-size, 24px);
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    translate: 0 0 0;
    background-color: var(--primary, rgb(150, 150, 150));
    -unity-background-image-tint-color: var(--secondary, rgb(20, 20, 20));
    border-width: var(--control-border-width, 1px);
    border-color: var(--primary, rgb(150, 150, 150));
}

ScrollView #unity-low-button:hover,
ScrollView #unity-high-button:hover {
    background-color: var(--highlight, rgb(255, 255, 255));
    border-color: var(--highlight, rgb(255, 255, 255));
}

ScrollView .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
    margin-top: var(--scrollbar-button-clearance, 28px);
    margin-bottom: var(--scrollbar-button-clearance, 28px);
}

ScrollView .unity-scroller--horizontal > .unity-scroller__slider {
    margin: 0;
    margin-left: var(--scrollbar-button-clearance, 28px);
    margin-right: var(--scrollbar-button-clearance, 28px);
}

ScrollView .unity-scroller__slider #unity-tracker {
    margin: 0;
}

ScrollView .unity-scroller__slider #unity-dragger {
    margin: 0;
}

ScrollView .unity-scroller__slider #unity-dragger-border {
    background-color: transparent;
    border-width: 0;
}

ScrollView .unity-scroll-view__vertical-scroller #unity-drag-container,
ScrollView .unity-scroll-view__vertical-scroller #unity-dragger {
    min-width: var(--scrollbar-size, 24px);
    max-width: var(--scrollbar-size, 24px);
    align-self: center;
}

ScrollView .unity-scroll-view__vertical-scroller #unity-dragger {
    left: 0;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-drag-container,
ScrollView .unity-scroll-view__horizontal-scroller #unity-dragger {
    min-height: var(--scrollbar-size, 24px);
    max-height: var(--scrollbar-size, 24px);
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-drag-container {
    align-self: center;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-dragger {
    top: 0;
}

/* Stacked form fields */

.stacked-field.unity-base-slider #unity-tracker {
    height: 10px;
    margin-top: -5px;
}

.stacked-field.unity-base-slider #unity-dragger {
    margin-top: -18px;
    height: 36px;
}

.stacked-field {
    flex-direction: column;
    align-items: stretch;
}

.stacked-field .unity-base-field__label {
    min-width: auto;
    width: auto;
    margin: 0;
}

.unity-base-field {
    margin: var(--spacing-small, 4px);
}

.stacked-field .unity-base-slider__input {
    max-height: 36px;
    flex-grow: 0;
    margin: 0;
}

.stacked-field .unity-base-slider__text-field {
    flex-grow: 0;
    width: 72px;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 0;
}

.stacked-field .unity-radio-button-group__container {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Tab view */

.unity-tab__header {
    --text-color: var(--secondary, rgb(20, 20, 20));
    background-color: var(--primary, rgb(150, 150, 150));
    border-width: var(--control-border-width, 1px);
    border-bottom-width: 0;
    border-color: var(--primary, rgb(150, 150, 150));
    min-height: var(--control-min-height, 46px);
    font-size: var(--font-size-body, 20px);
    padding: 0;
    padding-left: var(--spacing-large, 12px);
    padding-right: var(--spacing-large, 12px);
    margin-right: var(--spacing-small, 4px);
    justify-content: center;
}

.unity-tab__header:checked,
.unity-tab__header:hover:enabled {
    background-color: var(--highlight, rgb(255, 255, 255));
}

.unity-tab__header-label {
    -unity-text-align: middle-center;
    margin: 0;
    color: var(--secondary, rgb(20, 20, 20));
}

.unity-tab__header-underline {
    display: none;
}

.unity-tab-view__content-viewport {
    background-color: transparent;
}

.unity-tab-view__header-container {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: var(--control-border-width, 1px);
    border-bottom-color: var(--primary, rgb(150, 150, 150));
    width: 100%;
}

.unity-tab__content-container {
    flex-grow: 1;
    padding-top: var(--spacing-medium, 8px);
}

.unity-tab-view__content-container,
.unity-tab {
    flex-grow: 1;
    min-height: 0;
}

/* Multi-column lists */

.unity-multi-column-header {
    min-height: auto;
}

.unity-multi-column-header,
.unity-multi-column-header__column,
.unity-multi-column-header__column__content-container {
    --text-color: var(--secondary, rgb(20, 20, 20));
    background-color: var(--primary, rgb(150, 150, 150));
    border-color: var(--primary, rgb(150, 150, 150));
}

.unity-multi-column-header__column:hover,
.unity-multi-column-header__column:hover .unity-multi-column-header__column__content-container {
    background-color: var(--highlight, rgb(255, 255, 255));
}

.unity-multi-column-header__column__title {
    color: var(--secondary, rgb(20, 20, 20));
}

.unity-collection-view__item:hover:enabled,
.unity-collection-view__item--selected {
    --text-color: var(--secondary, rgb(20, 20, 20));
    background-color: var(--highlight, rgb(255, 255, 255));
}

/* Split views */

.unity-two-pane-split-view__dragline-anchor {
    position: absolute;
    background-color: var(--primary, rgb(150, 150, 150));
}

.unity-two-pane-split-view__dragline-anchor:hover {
    background-color: var(--highlight, rgb(255, 255, 255));
}

.unity-two-pane-split-view__dragline-anchor--horizontal {
    width: 4px;
    height: 100%;
}

.unity-two-pane-split-view__dragline-anchor--vertical {
    height: 4px;
    width: 100%;
}

.unity-two-pane-split-view__dragline--horizontal {
    position: absolute;
    width: 12px;
    height: 100%;
    left: -4px;
}

.unity-two-pane-split-view__dragline--vertical {
    position: absolute;
    height: 12px;
    width: 100%;
    top: -4px;
}

/* Status chips */

.chip {
    margin-right: var(--spacing-small, 4px);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    color: rgb(0, 12, 24);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.chip--good {
    background-color: rgb(76, 196, 112);
}

.chip--fair {
    background-color: rgb(226, 199, 74);
}

.chip--low {
    background-color: rgb(238, 148, 58);
}

.chip--critical {
    background-color: rgb(228, 79, 70);
}

.chip--unknown {
    background-color: rgb(86, 102, 118);
    color: rgb(214, 229, 245);
}

/* Team colors */

.team-red {
    color: rgb(255, 0, 38);
}

.team-blue {
    color: rgb(0, 191, 255);
}

.team-red-bg {
    background-color: rgb(255, 0, 38);
}

.team-blue-bg {
    background-color: rgb(0, 191, 255);
}
