<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="GameMenu" entry="match-start-warnings.title"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:Label name="missing-bases-warning" class="body-copy">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="bases.required-instructions"/>
            </Bindings>
        </ui:Label>
        <ui:Label name="missing-flags-warning" class="body-copy">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="flags.required-instructions"/>
            </Bindings>
        </ui:Label>
        <ui:Label name="missing-both-team-flags-warning" class="body-copy">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="flags.both-teams-required-instructions"/>
            </Bindings>
        </ui:Label>
        <ui:Button name="match-warnings-edit-map-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="bases.edit-map"/>
            </Bindings>
        </ui:Button>
        <ui:Button name="match-warnings-dismiss-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="ConnectionMenu" entry="ConnectionErrorPage.dismiss-error-button.text"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
