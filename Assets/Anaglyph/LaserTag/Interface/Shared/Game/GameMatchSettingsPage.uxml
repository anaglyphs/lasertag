<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Shared/Game/MatchSettings.uss"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="GameMenu" entry="GameMatchSettingsPage.navheader-2.title"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:ScrollView>
            <Anaglyph.Menu.DetentField name="points-field">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GameMenu" entry="GameMatchSettingsPage.points-field.label"/>
                </Bindings>
                <Anaglyph.Menu.DetentMark class="match-icon match-icon--kills">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.points-field.kills"/>
                    </Bindings>
                </Anaglyph.Menu.DetentMark>
                <Anaglyph.Menu.DetentMark class="match-icon match-icon--flag">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.points-field.flag-captures"/>
                    </Bindings>
                </Anaglyph.Menu.DetentMark>
            </Anaglyph.Menu.DetentField>
            <Anaglyph.Menu.DetentField name="end-field">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GameMenu" entry="GameMatchSettingsPage.end-field.label"/>
                </Bindings>
                <Anaglyph.Menu.DetentMark class="match-icon match-icon--hourglass">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.end-field.timed"/>
                    </Bindings>
                </Anaglyph.Menu.DetentMark>
                <Anaglyph.Menu.DetentMark class="match-icon match-icon--podium">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.end-field.score"/>
                    </Bindings>
                </Anaglyph.Menu.DetentMark>
            </Anaglyph.Menu.DetentField>
            <Anaglyph.Menu.DetentField name="round-time-field" cumulative="true">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GameMenu" entry="GameMatchSettingsPage.round-time-field.label"/>
                </Bindings>
            </Anaglyph.Menu.DetentField>
            <Anaglyph.Menu.DetentField name="score-target-field" cumulative="true">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GameMenu" entry="GameMatchSettingsPage.score-target-field.label"/>
                </Bindings>
            </Anaglyph.Menu.DetentField>
            <Anaglyph.Menu.DetentField name="rounds-field" cumulative="true">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GameMenu" entry="GameMatchSettingsPage.rounds-field.label"/>
                </Bindings>
            </Anaglyph.Menu.DetentField>
            <Anaglyph.Menu.DetentField name="respawn-field">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GameMenu" entry="GameMatchSettingsPage.respawn-field.label"/>
                </Bindings>
                <Anaglyph.Menu.DetentMark class="match-icon match-icon--next-round">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.respawn-field.next-round"/>
                    </Bindings>
                </Anaglyph.Menu.DetentMark>
                <Anaglyph.Menu.DetentMark class="match-icon match-icon--base">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.respawn-field.at-base"/>
                    </Bindings>
                </Anaglyph.Menu.DetentMark>
            </Anaglyph.Menu.DetentField>
	        <Anaglyph.Menu.DetentField name="damage-field" cumulative="true">
		        <Bindings>
			        <UnityEngine.Localization.LocalizedString property="label" table="GameMenu" entry="GameMatchSettingsPage.damage-field.label"/>
		        </Bindings>
		        <Anaglyph.Menu.DetentMark class="match-icon match-icon--ramp-1">
			        <Bindings>
				        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.damage-field.low"/>
			        </Bindings>
		        </Anaglyph.Menu.DetentMark>
		        <Anaglyph.Menu.DetentMark class="match-icon match-icon--ramp-2">
			        <Bindings>
				        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.damage-field.medium"/>
			        </Bindings>
		        </Anaglyph.Menu.DetentMark>
		        <Anaglyph.Menu.DetentMark class="match-icon match-icon--ramp-3">
			        <Bindings>
				        <UnityEngine.Localization.LocalizedString property="Text" table="GameMenu" entry="GameMatchSettingsPage.damage-field.high"/>
			        </Bindings>
		        </Anaglyph.Menu.DetentMark>
	        </Anaglyph.Menu.DetentField>
            <ui:Toggle name="spawn-zombies-toggle" style="display: none;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="GameMatchSettingsPage.spawn-zombies-toggle.text"/>
                </Bindings>
            </ui:Toggle>
        </ui:ScrollView>
        <ui:Button name="start-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GameMenu" entry="GameMatchSettingsPage.start-button.text"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
