.match-icon {
    width: 52px;
    height: 52px;
    margin-left: var(--spacing-large, 12px);
    align-self: center;
    background-size: contain;
}

.match-icon--kills { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/kills.svg"); }
.match-icon--flag { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/flag.svg"); }
.match-icon--hourglass { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/hourglass.svg"); }
.match-icon--podium { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/podium.svg"); }
.match-icon--base { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/base.svg"); }
.match-icon--next-round { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/next-round.svg"); }

/* The ramp thirds read as one rising wedge */
.match-icon--ramp-1,
.match-icon--ramp-2,
.match-icon--ramp-3 {
    width: 48px;
    margin-left: var(--spacing-small, 4px);
    background-size: 100% 100%;
}

.match-icon--ramp-1 { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/ramp-1.svg"); }
.match-icon--ramp-2 { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/ramp-2.svg"); }
.match-icon--ramp-3 { background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/ramp-3.svg"); }

/* The infinite-rounds section points onward */
.detent-field__segment.match-segment--arrow {
    background-color: transparent;
    background-image: url("project://database/Assets/Anaglyph/LaserTag/Interface/Graphics/Match/arrow.svg");
    /* Slicing keeps the point's size while the body stretches to the section's width */
    -unity-slice-right: 15;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}
