<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="AlignmentSettings" src="project://database/Assets/Anaglyph/LaserTag/Interface/Shared/Game/AlignmentSettings.uxml?fileID=9197481963319205126&amp;guid=afec34b4c8614b298966b93971268b33&amp;type=3#AlignmentSettings"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Shared/Game/MapFields.uss?fileID=7433441132597879392&amp;guid=f4c687285f094fca87062d2e41ca92d4&amp;type=3#MapFields"/>
    <ui:VisualElement class="page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="GameMenu" entry="space.details"/>
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:ScrollView class="map-settings-scroll">
            <ui:TextField name="space-name-field" keyboard-type="Default" class="stacked-field"/>
            <ui:Instance template="AlignmentSettings"/>
            <ui:Button name="reset-space-alignment" class="destructive"/>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
