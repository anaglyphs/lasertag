<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Menu/UI%20Toolkit/LaserTagMenu.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagMenu"/>
    <ui:VisualElement picking-mode="Ignore" class="menu-root game-panel palette-root">
        <ui:VisualElement picking-mode="Ignore" class="palette-body">
            <ui:ScrollView name="category-rail" mode="Vertical" vertical-scroller-visibility="Hidden" class="palette-rail"/>
            <ui:VisualElement picking-mode="Ignore" class="palette-content">
                <ui:Label name="category-title" text="Palette" class="palette-title"/>
                <ui:VisualElement picking-mode="Ignore" class="palette-tools">
                    <ui:Button name="move-tool-button" text="Move" class="palette-tool"/>
                    <ui:Button name="tag-tool-button" text="Tags" class="palette-tool"/>
                </ui:VisualElement>
                <ui:ScrollView name="object-grid" mode="Vertical" class="palette-grid"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="done-button" text="Done" class="palette-done"/>
    </ui:VisualElement>
</ui:UXML>
