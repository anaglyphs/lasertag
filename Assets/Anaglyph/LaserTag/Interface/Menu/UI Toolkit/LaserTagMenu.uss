* {
	-unity-font-definition: url("project://database/Assets/Fonts/Zector SDF.asset");
	color: rgb(255, 255, 255);
}

.menu-root {
    flex-grow: 1;
    padding: 16px;
    background-color: rgb(20, 20, 20);
    color: rgb(255, 255, 255);
    font-size: 20px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    
    /*-unity-font-definition: url("project://database/Assets/Anaglyph/LaserTag/Interface/Fonts/zector/Zector SDF 1.asset");*/
}

.multiplayer-panel {
    border-color: rgb(255, 0, 21);
    background-color: rgb(27, 0, 33);
}

.game-panel {
    border-color: rgb(0, 255, 173);
    background-color: rgb(0, 14, 49);
}

.settings-panel {
    border-color: rgb(255, 116, 0);
    background-color: rgb(24, 36, 0);
}

.unity-toggle__checkmark,
.back-button {
	margin-right: 10px;
}

.unity-base-text-field > .unity-base-text-field__input,
.unity-toggle > .unity-toggle__input > .unity-toggle__checkmark,
Button {
	background-color: rgba(0, 0, 0, 0);
	border-width: 1px;
	border-color: rgb(255, 255, 255);
}

Toggle {
	min-height: 30px;
}

.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
	background-image: none;
	background-color: rgb(230, 230, 230);
}

.pages,
.nav-page {
    flex-grow: 1;
}

.nav-page {
    justify-content: flex-start;
}

.page-template-root {
    flex-grow: 1;
    justify-content: flex-start;
}

.header {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    margin-bottom: 8px;
}

.title {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 28px;
    /*-unity-font-style: bold;*/
}

.field-row {
    margin-top: 4px;
    margin-bottom: 4px;
}

.warning {
    color: rgb(255, 210, 80);
    white-space: normal;
}

.error-subject {
    flex-grow: 0;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.body-copy {
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 8px;
}

.version {
    margin-top: auto;
    font-size: 14px;
    white-space: normal;
}

Button {
    -unity-text-align: middle-left;
    background-color: rgb(70, 70, 70);
}

Button,
Toggle,
TextField {
    min-height: 46px;
    margin-top: 4px;
    margin-bottom: 4px;
    font-size: 20px;
	translate: 0 0 5px;
	justify-content: center;
}

.unity-toggle__text {
	padding-top: 0;
	padding-bottom: 0;
	margin-top: 0;
	margin-bottom: 0;
}

.permission-toggle.permission-granted:disabled {
    opacity: 1;
}

ScrollView {
    flex-grow: 1;
}

.back-button {
    aspect-ratio: 1;
    min-height: auto;
}

/* ================= console ================= */

.console-scroll {
    /* size from the space left over, never from the log inside it */
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    background-color: rgba(0, 0, 0, 0.5);
    padding: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.console-entry {
    font-size: 14px;
    white-space: normal;
    margin-bottom: 6px;
}

.console-entry.console-entry-warning {
    color: rgb(255, 210, 80);
}

.console-entry.console-entry-error {
    color: rgb(255, 130, 130);
}

.console-controls {
    flex-direction: row;
    align-items: center;
}

.console-controls > Toggle {
    flex-grow: 1;
}

.console-clear-button {
    width: 130px;
    margin-left: 8px;
    -unity-text-align: middle-center;
}

/* ================= map editor palette ================= */

.palette-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* category tabs down the left, objects of that category beside them */
.palette-rail {
    flex-grow: 0;
    flex-shrink: 0;
    width: 84px;
    margin-right: 8px;
}

.palette-content {
    flex-grow: 1;
    min-width: 0;
}

.palette-title {
    font-size: 26px;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.palette-tools {
    flex-direction: row;
}

.palette-tool {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 38px;
    font-size: 16px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-text-align: middle-center;
}

.palette-grid {
    flex-grow: 1;
    min-height: 0;
}

/* the grid is a wrapping row of thumbnails, not the default column of rows */
.palette-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.palette-tab,
.palette-item {
    align-items: center;
    justify-content: flex-start;
    min-height: auto;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.35);
}

.palette-tab {
    margin: 0 0 6px 0;
}

/* percentage widths so a narrower panel drops to fewer columns instead of clipping */
.palette-item {
    width: 30%;
    margin: 4px;
}

.palette-tab-icon,
.palette-item-icon {
    background-color: rgba(255, 255, 255, 0.07);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

/* a tab is a small badge, so plenty of categories fit the rail without scrolling */
.palette-tab-icon {
    width: 44px;
    height: 44px;
}

.palette-item-icon {
    width: 100%;
    aspect-ratio: 1;
}

.palette-tab-label,
.palette-item-label {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.palette-tab-label {
    font-size: 11px;
}

.palette-item-label {
    font-size: 14px;
}

.palette-tab.selected,
.palette-item.selected,
.palette-tool.selected {
    background-color: rgb(230, 230, 230);
}

.palette-tool.selected,
.palette-tab.selected .palette-tab-label,
.palette-item.selected .palette-item-label {
    color: rgb(0, 14, 49);
}

.palette-tab.selected .palette-tab-icon,
.palette-item.selected .palette-item-icon {
    background-color: rgba(0, 0, 0, 0.1);
}

.palette-done {
    align-self: center;
    min-width: 140px;
    -unity-text-align: middle-center;
}

/* ================= HUD ================= */

.hud-root {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Playbeing/DInish/DINishExpanded-Regular%20SDF.asset");
}

.hud-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.team-red {
    color: rgb(255, 0, 38);
}

.team-blue {
    color: rgb(0, 191, 255);
}

.team-red-bg {
    background-color: rgb(255, 0, 38);
}

.team-blue-bg {
    background-color: rgb(0, 191, 255);
}

/* death popup */

.you-died-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.you-died-label {
    font-size: 60px;
    color: rgb(255, 119, 119);
    -unity-text-align: middle-center;
}

.death-bar {
    width: 94px;
    height: 30px;
    background-color: rgb(255, 120, 120);
}

.respawn-label {
    font-size: 30px;
    -unity-text-align: middle-center;
}

/* countdown */

.queue-label {
    font-size: 30px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.countdown-label {
    position: absolute;
    font-size: 140px;
    -unity-text-align: middle-center;
}

/* game end */

.game-end-title {
    font-size: 60px;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

.game-end-scores {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.game-end-score {
    font-size: 60px;
    width: 200px;
}

.vs-label {
    font-size: 60px;
    width: 100px;
    -unity-text-align: middle-center;
}

/* connection status */

.connection-label {
    font-size: 45px;
    -unity-text-align: middle-center;
}

/* ================= hand HUD ================= */

.hand-hud-section {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.timer-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.timer-score {
    font-size: 32px;
    width: 45px;
}

.hourglass {
    align-items: center;
    margin-left: 10px;
    margin-right: 10px;
}

.hourglass-chamber {
    width: 60px;
    height: 20px;
    justify-content: flex-end;
    align-items: center;
}

.top-sand {
    width: 30px;
    background-color: rgb(255, 255, 255);
}

.bottom-sand {
    width: 60px;
    background-color: rgb(255, 255, 255);
}

.timer-label {
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-top: 1px;
    margin-bottom: 1px;
}

/* score goal */

.goal-carrot {
    width: 12px;
    height: 8px;
    background-color: rgb(255, 255, 255);
    margin-bottom: 2px;
}

.score-track {
    flex-direction: row;
    width: 180px;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.35);
}

.score-track-half {
    width: 50%;
    height: 100%;
    flex-direction: row;
}

.score-track-half.from-right {
    justify-content: flex-end;
}

.score-line {
    height: 100%;
    width: 0;
}

.goal-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
}

.goal-score {
    font-size: 32px;
    width: 60px;
}

.goal-target-label {
    font-size: 24px;
    width: 70px;
    -unity-text-align: middle-center;
}
