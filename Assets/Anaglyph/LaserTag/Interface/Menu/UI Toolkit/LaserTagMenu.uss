.menu-root {
	flex-grow: 1;
	padding: 16px;
	background-color: rgb(20, 20, 20);
	color: rgb(255, 255, 255);
	font-size: 20px;
	border-width: 2px;
	border-color: rgb(255, 255, 255);

	-unity-font-definition: url("/Assets/Playbeing/DInish/DINish-Regular SDF.asset");
}

.multiplayer-panel {
	border-color: #FF0015;
	background-color: #1B0021;
}

.game-panel {
	border-color: #00FFAD;
	background-color: #000E31;
}

.settings-panel {
	border-color: #FF7400;
	background-color: #182400;
}

.pages,
.nav-page {
	flex-grow: 1;
}

.nav-page {
	justify-content: flex-start;
}

.page-template-root {
	flex-grow: 1;
	justify-content: flex-start;
}

.header {
	flex-direction: row;
	align-items: center;
	min-height: 52px;
	margin-bottom: 8px;
}

.title {
	flex-grow: 1;
	-unity-text-align: middle-left;
	font-size: 28px;
	-unity-font-style: bold;
}

.field-row {
	margin-top: 4px;
	margin-bottom: 4px;
}

.warning {
	color: rgb(255, 210, 80);
	white-space: normal;
}

.body-copy {
	white-space: normal;
	margin-top: 8px;
	margin-bottom: 8px;
}

.version {
	margin-top: auto;
	font-size: 14px;
	white-space: normal;
}

Button {
	-unity-text-align: middle-left;
	border-width: 2px;
	border-color: rgb(255, 255, 255);
	background-color: rgb(100, 100, 100);
}

Button,
Toggle,
TextField {
	min-height: 46px;
	margin-top: 4px;
	margin-bottom: 4px;
	font-size: 20px;
}

Button,
Toggle {
	translate: 0 0 5px;
}

.permission-toggle.permission-granted:disabled {
	opacity: 1;
}

ScrollView {
	flex-grow: 1;
}
