<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavHeader" src="project://database/Assets/Anaglyph/LaserTag/Interface/Menu/UI%20Toolkit/NavHeader.uxml?fileID=9197481963319205126&amp;guid=6fb045f52b6e5428ea70fca9635fe4c6&amp;type=3#NavHeader"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Menu/UI%20Toolkit/LaserTagMenu.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagMenu"/>
    <ui:VisualElement class="page-template-root">
        <ui:Instance template="NavHeader">
            <AttributeOverrides element-name="title" text="Play match"/>
        </ui:Instance>
        <ui:ScrollView>
            <ui:IntegerField label="Rounds" value="1" name="rounds-field"/>
            <ui:FloatField label="Damage strength" value="1" name="damage-multiplier-field"/>
            <ui:RadioButtonGroup label="Win by" choices="Time,Points,Either" name="win-by-radio"/>
            <ui:FloatField label="Round time (mins)" value="3" name="round-time-field"/>
            <ui:IntegerField label="Score target" value="10" name="score-target-field"/>
            <ui:RadioButtonGroup label="Respawn&#10;" name="respawn-condition-radio" choices="After a timer,At home base,Only per round"/>
            <ui:FloatField label="Respawn time (sec)" value="10" name="respawn-time-field"/>
        </ui:ScrollView>
        <ui:Button name="start-button" text="Start game"/>
    </ui:VisualElement>
</ui:UXML>
