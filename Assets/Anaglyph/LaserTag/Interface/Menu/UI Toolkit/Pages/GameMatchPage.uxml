<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavHeader" src="project://database/Assets/Anaglyph/LaserTag/Interface/Menu/UI%20Toolkit/NavHeader.uxml?fileID=9197481963319205126&amp;guid=6fb045f52b6e5428ea70fca9635fe4c6&amp;type=3#NavHeader"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Menu/UI%20Toolkit/LaserTagMenu.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagMenu"/>
    <ui:VisualElement class="page-template-root">
        <ui:Instance template="NavHeader">
            <AttributeOverrides element-name="title" text="Play match"/>
        </ui:Instance>
        <ui:ScrollView>
            <ui:Toggle name="win-by-score-toggle" text="Win by points" value="true" style="flex-direction: row;"/>
            <ui:VisualElement name="time-field-row" class="field-row">
                <ui:Label text="Time (minutes)"/>
                <ui:TextField name="time-field" keyboard-type="DecimalPad"/>
            </ui:VisualElement>
            <ui:VisualElement name="score-field-row" class="field-row">
                <ui:Label text="Score target"/>
                <ui:TextField name="score-field" keyboard-type="NumberPad"/>
            </ui:VisualElement>
            <ui:VisualElement class="field-row">
                <ui:Label text="Damage strength"/>
                <ui:TextField name="damage-multiplier-field" keyboard-type="DecimalPad"/>
            </ui:VisualElement>
            <ui:Button name="start-button" text="Start game"/>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
