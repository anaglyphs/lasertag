<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavHeader" src="project://database/Assets/Anaglyph/LaserTag/Interface/Menu/UI%20Toolkit/NavHeader.uxml?fileID=9197481963319205126&amp;guid=6fb045f52b6e5428ea70fca9635fe4c6&amp;type=3#NavHeader"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/Menu/UI%20Toolkit/LaserTagMenu.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagMenu"/>
    <ui:VisualElement class="page-template-root">
        <ui:Instance template="NavHeader">
            <AttributeOverrides element-name="title" text="Host settings"/>
        </ui:Instance>
        <ui:ScrollView>
            <ui:Toggle name="host-on-relay-toggle" text="Relay server"/>
            <ui:Label name="host-on-relay-warning" text="Relay hosting requires a full internet connection." class="warning" style="display: none;"/>
            <ui:Toggle name="use-april-tags-toggle" text="Use AprilTags"/>
            <ui:Label name="use-april-tags-warning" text="Cloud alignment requires a full internet connection." class="warning" style="display: none;"/>
            <ui:VisualElement class="field-row">
                <ui:Label text="AprilTag size (cm)"/>
                <ui:TextField name="april-tag-size-field" keyboard-type="NumbersAndPunctuation"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
