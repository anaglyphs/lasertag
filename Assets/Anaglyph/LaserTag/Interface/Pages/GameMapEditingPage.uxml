<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="MapEditorTagsPage" src="project://database/Assets/Anaglyph/LaserTag/Interface/Pages/GameMapAlignmentPage.uxml?fileID=9197481963319205126&amp;guid=ed92c43d12f68469096f4eccf3dc248b&amp;type=3#GameMapAlignmentPage"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <Anaglyph.Menu.NavView name="map-editing-nav" first-page="map-options-page">
        <Anaglyph.Menu.NavPage name="map-options-page" show-back-button="false">
            <ui:VisualElement class="page-template-root">
                <Anaglyph.Menu.NavHeader title="Edit map"/>
                <ui:TextField name="map-name-field" label="Name" max-length="40" class="stacked-field"/>
                <ui:Label name="map-name-note" class="warning"/>
                <Anaglyph.Menu.NavButton name="tags-mode-button" target="alignment-settings-page" text="Alignment Settings"/>
                <ui:Label text="- Trigger: place objects / set dominant hand\n- Grip: grab and move object\n- Y/B: delete object" parse-escape-sequences="true" class="body-copy"/>
                <ui:VisualElement style="flex-grow: 1;"/>
                <ui:Button name="finish-editing-button" text="Finish editing"/>
            </ui:VisualElement>
        </Anaglyph.Menu.NavPage>
        <Anaglyph.Menu.NavPage name="alignment-settings-page">
            <ui:Instance template="MapEditorTagsPage"/>
        </Anaglyph.Menu.NavPage>
    </Anaglyph.Menu.NavView>
</ui:UXML>
