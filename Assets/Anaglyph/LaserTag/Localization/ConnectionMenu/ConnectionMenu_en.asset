      m_Items: []
  - m_Id: 26032498533195802
    m_Localized: Bluetooth is switched off. Direct hosting needs it so nearby players can find your session.
    m_Metadata:
      m_Items: []
  - m_Id: 26032498533195803
    m_Localized: This device isn't connected to a Wi-Fi network. Join one to host on it.
    m_Metadata:
      m_Items: []
