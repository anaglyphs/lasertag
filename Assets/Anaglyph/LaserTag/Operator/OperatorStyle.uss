.operator-panel {
    align-self: flex-start;
    width: 620px;
    background-color: rgb(0, 12, 24);
}

#session-address {
    flex-shrink: 0;
    font-size: 38px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 12px;
    margin-bottom: 12px;
    color: rgb(130, 230, 255);
}

#client-list {
    flex-grow: 1;
    min-height: 0;
    margin: 0;
}

.client-cell {
    flex-grow: 1;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.client-cell--name {
    -unity-font-style: bold;
}

.client-cell--status {
    opacity: 0.7;
}

.client-list-content {
    min-width: 300px;
}

.headset-configuration-panel {
    min-width: 340px;
}

#sidebar {
    min-width: 260px;
}

#tabs {
    min-height: 160px;
}

#viewport {
    min-height: 160px;
    min-width: 200px;
}
