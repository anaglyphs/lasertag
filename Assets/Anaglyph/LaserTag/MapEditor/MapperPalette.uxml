<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="MapEditorHomePage" src="project://database/Assets/Anaglyph/LaserTag/Interface/Pages/MapEditorHomePage.uxml?fileID=9197481963319205126&amp;guid=ea4f01870a7bd4e83a58494d9ce36e84&amp;type=3#MapEditorHomePage"/>
    <ui:Template name="MapEditorObjectsPage" src="project://database/Assets/Anaglyph/LaserTag/Interface/Pages/MapEditorObjectsPage.uxml?fileID=9197481963319205126&amp;guid=319b1949f04e543a5bc9ea6862887d2e&amp;type=3#MapEditorObjectsPage"/>
    <ui:Template name="MapEditorSettingsPage" src="project://database/Assets/Anaglyph/LaserTag/Interface/Pages/MapEditorSettingsPage.uxml?fileID=9197481963319205126&amp;guid=6a72de107b8804566a1e51d0a5c61033&amp;type=3#MapEditorSettingsPage"/>
    <ui:Template name="MapEditorTagsPage" src="project://database/Assets/Anaglyph/LaserTag/Interface/Pages/MapEditorTagsPage.uxml?fileID=9197481963319205126&amp;guid=ed92c43d12f68469096f4eccf3dc248b&amp;type=3#MapEditorTagsPage"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle"/>
    <ui:VisualElement picking-mode="Ignore" class="menu-root game-panel palette-root">
        <Anaglyph.Menu.NavView first-page="home-page">
            <Anaglyph.Menu.NavPage name="home-page" show-back-button="false">
                <ui:Instance template="MapEditorHomePage"/>
            </Anaglyph.Menu.NavPage>
            <Anaglyph.Menu.NavPage name="objects-page" style="display: none;">
                <ui:Instance template="MapEditorObjectsPage"/>
            </Anaglyph.Menu.NavPage>
            <Anaglyph.Menu.NavPage name="tags-page">
                <ui:Instance template="MapEditorTagsPage"/>
            </Anaglyph.Menu.NavPage>
            <Anaglyph.Menu.NavPage name="map-settings-page">
                <ui:Instance template="MapEditorSettingsPage"/>
            </Anaglyph.Menu.NavPage>
        </Anaglyph.Menu.NavView>
        <ui:Button name="done-button" text="Done" class="palette-done"/>
    </ui:VisualElement>
</ui:UXML>
