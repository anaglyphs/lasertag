<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="TagSizeField" src="project://database/Assets/Anaglyph/LaserTag/MapEditor/TagSizeField.uxml?fileID=9197481963319205126&amp;guid=0eaae135bf94481ca7c2e02a6df95351&amp;type=3#TagSizeField"/>
    <Style src="project://database/Assets/Anaglyph/LaserTag/Interface/LaserTagStyle.uss?fileID=7433441132597879392&amp;guid=9bde092a3b54b4999a5046033ab19531&amp;type=3#LaserTagStyle" />
    <ui:VisualElement picking-mode="Ignore" class="menu-root game-panel page-template-root">
        <Anaglyph.Menu.NavHeader>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Title" table="Map" entry="ruler.title" />
            </Bindings>
        </Anaglyph.Menu.NavHeader>
        <ui:ScrollView mode="Vertical" class="palette-step-scroll">
            <ui:Label name="tag-setup-measure-instructions" class="body-copy tag-setup-hidden"/>
            <ui:Instance template="TagSizeField"/>
            <ui:Label name="tag-measurement-hint" class="body-copy"/>
            <ui:Button name="clear-tags-for-measurement" class="destructive tag-setup-hidden"><Bindings><UnityEngine.Localization.LocalizedString property="text" table="Map" entry="GameMapAlignmentPage.unregister-all-tags-button.text"/></Bindings></ui:Button>
        </ui:ScrollView>
        <ui:Button name="continue-tag-registration"><Bindings><UnityEngine.Localization.LocalizedString property="text" table="Map" entry="tag-setup.next"/></Bindings></ui:Button>
    </ui:VisualElement>
</ui:UXML>
