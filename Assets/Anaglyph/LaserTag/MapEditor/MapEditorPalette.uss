/* Map editor palette */

.palette-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* Every object shares one category for now, so the category list stays hidden */
.palette-rail {
    display: none;
    flex-grow: 0;
    flex-shrink: 0;
    width: 84px;
    margin-right: 8px;
}

.palette-content {
    flex-grow: 1;
    min-width: 0;
}

/* The object page's panel is as tall as its grid; the rest of the document stays clear */
#objects-page .palette-root,
#objects-page .palette-body,
#objects-page .palette-grid {
    flex-grow: 0;
}

/* Object grid */

.palette-grid {
    flex-grow: 1;
    min-height: 0;
}

.palette-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
}

.palette-tab,
.palette-item {
    align-items: center;
    justify-content: flex-start;
    min-height: auto;
    padding: 4px;
}

.palette-tab {
    margin: 0 0 6px 0;
}

/* Two to a row: the four bases and flags fill the panel */
.palette-item {
    width: 46%;
    margin: 6px;
}

.palette-tab-icon,
.palette-item-icon {
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
	-unity-background-image-tint-color: var(--secondary);
}

.palette-tab-icon {
    width: 44px;
    height: 44px;
}

.palette-item-icon {
    width: 100%;
    aspect-ratio: 1;
}

.palette-tab-label,
.palette-item-label {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.palette-tab-label {
    font-size: 11px;
}

.palette-item-label {
    font-size: 14px;
}

.palette-tab.selected,
.palette-item.selected {
    background-color: var(--primary-hover, rgb(255, 255, 255));
}

.palette-actions {
    flex-direction: row;
    justify-content: center;
}

.palette-done,
.palette-delete {
    min-width: 140px;
    -unity-text-align: middle-center;
}

/* Controllers delete with a button of their own */
.palette-delete {
    display: none;
}

/* While objects are placed, the menu page that opened the editor also closes it */
.palette-actions--placing-objects .palette-done {
    display: none;
}

/* Scroll directions, read by StyleDirectedScrollView */

.palette-rail,
.palette-grid {
    --scroll-direction: vertical;
}

/* Touch screens: a row of category names over a row of objects, with nothing drawn behind them */

.touch-screen .palette-tab-icon {
    display: none;
}

.touch-screen .palette-root {
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.touch-screen .palette-body {
    flex-direction: column;
}

.touch-screen .palette-rail,
.touch-screen .palette-grid {
    --scroll-direction: horizontal;
    flex-grow: 0;
    flex-shrink: 0;
    width: auto;
    margin-right: 0;
    margin-bottom: var(--spacing-medium, 8px);
}

.touch-screen .palette-grid .unity-scroll-view__content-container {
    flex-wrap: nowrap;
    justify-content: flex-start;
    min-width: 100%;
}

.touch-screen .palette-tab,
.touch-screen .palette-item {
    flex-shrink: 0;
    margin: 0 var(--spacing-medium, 8px) 0 0;
}

.touch-screen .palette-tab {
    justify-content: center;
    min-height: var(--control-min-height, 46px);
    padding: 0 var(--spacing-large, 12px);
}

.touch-screen .palette-tab-label {
    margin-top: 0;
    font-size: var(--font-size-body, 20px);
    white-space: nowrap;
}

/* The items share the row's width; past what fits at their narrowest, the row scrolls */
.touch-screen .palette-item {
    flex-grow: 1;
    flex-basis: 0;
    width: auto;
    min-width: 72px;
}

.touch-screen .palette-item:last-child {
    margin-right: 0;
}

.touch-screen .palette-delete {
    display: flex;
    margin-right: var(--spacing-medium, 8px);
}

/* The menu is off screen while objects are placed, so the palette closes the editor itself */
.touch-screen .palette-actions--placing-objects .palette-done {
    display: flex;
}

.touch-screen .palette-done,
.touch-screen .palette-delete {
    margin-top: 0;
    margin-bottom: 0;
}
